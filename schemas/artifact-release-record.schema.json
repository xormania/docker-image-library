{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "source_commit",
    "source_tag",
    "created_at",
    "input_fingerprint",
    "lifecycle",
    "definition",
    "publication",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^(image|binary|environment|configuration|context)/[a-z0-9][a-z0-9./-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_tag": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lifecycle": {
      "enum": [
        "available",
        "deprecated",
        "withdrawn"
      ]
    },
    "definition": {
      "type": "object"
    },
    "publication": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "filename",
        "size_bytes",
        "format",
        "public_download_verified_at",
        "evidence"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": [
            "file",
            "tar"
          ]
        },
        "public_download_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "surface",
        "evidence",
        "commands"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "minItems": 1
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "replacement": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

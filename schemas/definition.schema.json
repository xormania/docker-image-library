{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "family",
    "purpose",
    "capabilities",
    "extensions",
    "tools",
    "execution",
    "companions",
    "limitations",
    "lines"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "execution": {
      "type": "object"
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "runtime_line",
          "os",
          "revision",
          "platforms",
          "base",
          "changes",
          "migration"
        ],
        "properties": {
          "runtime_line": {
            "type": "string"
          },
          "os": {
            "const": "debian-trixie"
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "platforms": {
            "const": [
              "linux/amd64"
            ]
          },
          "base": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "tag",
                  "digest"
                ],
                "properties": {
                  "tag": {
                    "type": "string"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "parent"
                ],
                "properties": {
                  "parent": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "migration": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

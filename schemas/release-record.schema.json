{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "line_id",
    "version",
    "source_commit",
    "source_tag",
    "created_at",
    "definition",
    "resolved_base",
    "tools",
    "input_fingerprint",
    "platforms",
    "publication",
    "verification",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "line_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_tag": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "definition": {
      "type": "object"
    },
    "resolved_base": {
      "type": "string"
    },
    "tools": {
      "type": "object"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "digest",
          "inventory"
        ],
        "properties": {
          "platform": {
            "const": "linux/amd64"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "inventory": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "repository",
        "digest",
        "exact_tag",
        "public_pull_verified_at",
        "evidence"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^ghcr.io/xormania/"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "exact_tag": {
          "type": "string"
        },
        "public_pull_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "surface",
        "completed_at",
        "evidence"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "surface": {
          "const": "github-actions-linux-amd64"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "enum": [
        "available",
        "deprecated",
        "withdrawn"
      ]
    },
    "reason": {
      "type": "string"
    },
    "replacement": {
      "type": "string"
    },
    "lifecycle_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

{
  "purpose": "PHP and Symfony development plus real Chromium and Panther browser tests.",
  "capabilities": [
    "php",
    "composer",
    "symfony",
    "postgresql-client",
    "native-build",
    "xdebug",
    "browser",
    "panther"
  ],
  "extensions": [],
  "limitations": [
    "Chromium may need --no-sandbox where the host prohibits sandbox namespaces. Use only for trusted development content.",
    "Node is not included; request a separate capability when the project requires it."
  ],
  "schema_version": 1,
  "family": "php-browser",
  "tools": [
    "bash",
    "git",
    "gh",
    "curl",
    "jq",
    "rg",
    "psql"
  ],
  "execution": {
    "workspace": "/workspace",
    "home": "/home/dev",
    "default_uid": 1000,
    "default_gid": 1000,
    "uid_env": "PUID",
    "gid_env": "PGID",
    "cache_paths": [
      "/home/dev/.cache"
    ]
  },
  "companions": [
    "postgres:17-trixie",
    "redis:7.4"
  ],
  "lines": {
    "8.4-trixie": {
      "runtime_line": "8.4",
      "os": "debian-trixie",
      "revision": "1.0.0",
      "platforms": [
        "linux/amd64"
      ],
      "base": {
        "parent": "php-dev/8.4-trixie"
      },
      "changes": [
        "Initial stable development profile."
      ],
      "migration": "First release; no previous library revision."
    },
    "8.5-trixie": {
